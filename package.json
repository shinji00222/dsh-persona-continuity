{
  "name": "dsh-persona-continuity",
  "version": "0.2.0-preview.14",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "description": "Per-persona cross-session memory and survey simulation for DeepSeek Harness.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "docs/research.md",
    "docs/project-plan.md",
    "docs/simulation-plan.md",
    "docs/simulation-research.md",
    "docs/development-log.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check lib/store.js && node --check lib/extract.js && node --check lib/web.js && node --check lib/simulation.js && node --check lib/history.js",
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "external": ["@deepseek-ai/dsh-client-ui-primitives"]
    }
  }
}
